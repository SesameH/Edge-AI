# Build output (all generated; never edit by hand)
build/
build-*/
cmake-build-*/
sdk/pkg-unirt/
target/
compile_commands.json

# Gradle local cache (bindings/android) — gradle/wrapper + gradlew are committed
.gradle/
.cxx/
local.properties

# Built XCFramework (bindings/ios) — see bindings/ios/framework/CMakeLists.txt
*.xcframework/

# iOS example app: xcodegen regenerates the .xcodeproj from project.yml,
# and the bundled test model is a copy from models/ (see its README)
examples/ios/UniRTChatExample/UniRTChatExample.xcodeproj/
examples/ios/UniRTChatExample/UniRTChatExample/Info.plist
examples/ios/UniRTChatExample/Resources/*.gguf

# Android example app: bundled test models are downloads (see its README);
# .kotlin/ is Kotlin compiler session state, same class as .gradle/
examples/android/UniRTChatExample/app/src/main/assets/*.gguf
.kotlin/

# Xcode per-user state (scheme management, breakpoints) — not project config
**/xcuserdata/

# Test models (downloaded per README; hundreds of MB)
models/

# Release scratch: per-release wheels and assets, and the staging dir the
# publish steps write into. The scripts that produce them live in tools/release.
.release-work-*/
publish/

# Windows verification kit payload — re-fetched by
# tools/release/windows-verify/fetch-deps.sh, never committed (~110 MB)
tools/release/windows-verify/installers/
tools/release/windows-verify/deps/
tools/release/windows-verify/stage/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
dist/
*.egg-info/
wheelhouse/

# Editors & OS
.DS_Store
.idea/
.vscode/

.claude/
**/CLAUDE.md
# Local-only settings and secrets (HF tokens etc.)
.claude/settings.local.json
.env
